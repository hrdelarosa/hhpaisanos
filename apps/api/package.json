{
  "name": "@hhpaisanos/api",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "license": "UNLICENSED",
  "author": "",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "nest build && vp test run --exclude \"test/*.integration.test.mjs\"",
    "test:integration": "nest build && vp test run .integration.test.mjs --no-file-parallelism --testTimeout 30000",
    "db:generate": "drizzle-kit generate",
    "db:check": "nest build && node tools/database.mjs check",
    "db:migrate": "nest build && node tools/database.mjs migrate",
    "auth:bootstrap-admin": "nest build && node tools/bootstrap-admin.mjs",
    "roles:init-dev": "nest build && node tools/initialize-development-roles.mjs",
    "users:provision-permissions": "nest build && node tools/provision-users-permissions.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "argon2": "^0.45.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie": "^2.0.2",
    "drizzle-orm": "^0.45.4",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vite-plus": "1.5.0"
  }
}
