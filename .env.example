# Copy to .env at the repository root; replace both passwords locally.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hhpaisanos
DB_USER=hhpaisanos
DB_PASSWORD=replace-with-local-development-password
DB_ROOT_PASSWORD=replace-with-local-root-password
DB_POOL_SIZE=5

# Explicit browser origins for cookie-authenticated requests (comma-separated).
# Production requires NODE_ENV=production, HTTPS origins, and HTTPS transport.
AUTH_ORIGINS=http://localhost:5173
